# Tested RTX 3090 TensorRT flow-decoder profile. The engine is intentionally
# outside the model directory so model refreshes cannot silently replace it.
COSYVOICE_DEVICE=cuda
COSYVOICE_PLACEMENT=all-gpu
COSYVOICE_GPU_WEIGHT_DTYPE=fp16
COSYVOICE_LOAD_JIT=false
COSYVOICE_LOAD_TRT=true
COSYVOICE_TRT_ENGINE=/srv/cosyvoice2/accelerators/tensorrt/engines/flow.decoder.estimator.fp16.trt-10.13.3.9-sm86.plan
COSYVOICE_TRT_ONNX=/srv/cosyvoice2/model/flow.decoder.estimator.fp32.onnx
COSYVOICE_TRT_CONCURRENT=1

