# CosyVoice2 component placement: cpu, llm-gpu, acoustic-gpu,
# llm-flow-gpu, llm-hift-gpu, or all-gpu.
COSYVOICE_DEVICE=cuda
COSYVOICE_PLACEMENT=all-gpu
COSYVOICE_GPU_WEIGHT_DTYPE=fp16

# Reference-conditioning cache. Set either limit to 0 to disable it. Entries
# are held only in this process and are discarded when the service stops.
COSYVOICE_CONDITIONING_CACHE_ENTRIES=8
COSYVOICE_CONDITIONING_CACHE_MAX_BYTES=268435456
# Precompute the persisted saved voice and warm model kernels at startup.
# One-shot preview candidates are deliberately ignored.
COSYVOICE_WARMUP_ENABLED=true

# Public command adapter used by the Hermes profile plugin.
COSYVOICE_TRANSCRIBE_COMMAND=/srv/cosyvoice2/venv/bin/python /srv/cosyvoice2/app/transcribe.py --input {input_path}
COSYVOICE_WHISPER_MODEL=base
