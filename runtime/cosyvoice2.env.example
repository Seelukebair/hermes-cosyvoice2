# CosyVoice2 component placement: cpu, llm-gpu, acoustic-gpu,
# llm-flow-gpu, llm-hift-gpu, or all-gpu.
COSYVOICE_DEVICE=cuda
COSYVOICE_PLACEMENT=all-gpu
COSYVOICE_GPU_WEIGHT_DTYPE=fp16

# Public command adapter used by the Hermes profile plugin.
COSYVOICE_TRANSCRIBE_COMMAND=/srv/cosyvoice2/venv/bin/python /srv/cosyvoice2/app/transcribe.py --input {input_path}
COSYVOICE_WHISPER_MODEL=base

